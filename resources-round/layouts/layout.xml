<resources>
	<drawable-list id="backdrop" background="Graphics.COLOR_WHITE">
		<shape type="rectangle" x="0" y="0" width="100%" height="10%" color="Graphics.COLOR_BLACK" />
		<shape type="rectangle" x="0" y="90%" width="100%" height="11%" color="Graphics.COLOR_BLACK" />
	</drawable-list>
	<layouts>
		<layout id="MainLayout">
			<drawable id="backdrop" />
			<label id="clockValue" text="XX:XX" x="50%" y="5%" color="Graphics.COLOR_WHITE"
				font="Graphics.FONT_XTINY"
				justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

			<bitmap id="StopwatchIcon" x="15%" y="18%"
				filename="../../resources/drawables/stopwatch_64px_blk.png"
				scaleX="10%" scaleY="10%" />
			<label id="stopwatchValue" text="00:00" x="50%" y="23%" color="Graphics.COLOR_BLACK"
				font="Graphics.FONT_NUMBER_MEDIUM"
				justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

			<label id="maxChartValue" text="-" x="17%" y="47%"
				color="Graphics.COLOR_BLACK"
				font="Graphics.FONT_XTINY"
				justification="Graphics.TEXT_JUSTIFY_RIGHT | Graphics.TEXT_JUSTIFY_VCENTER" />
			<bitmap id="HeartSmallBlackIcon" x="8%" y="55%"
				filename="../../resources/drawables/heart_64px_black.png" scaleX="9%"
				scaleY="10%" />
			<bitmap id="ThermometerSmallBlackIcon" x="8%" y="55%"
				filename="../../resources/drawables/thermometer_64px_blk.png"
				scaleX="10%" scaleY="10%" />
			<label id="minChartValue" text="-" x="17%" y="71%"
				color="Graphics.COLOR_BLACK"
				font="Graphics.FONT_XTINY"
				justification="Graphics.TEXT_JUSTIFY_RIGHT | Graphics.TEXT_JUSTIFY_VCENTER" />

			<drawable id="Chart" class="ChartDrawable">
				<param name="color">Graphics.COLOR_BLACK</param>
				<param name="background">Graphics.COLOR_WHITE</param>
			</drawable>

			<bitmap id="UpDownBlackIcon" x="92%" y="50%"
				filename="../../resources/drawables/up_down_32px_blk.png" scaleX="6%"
				scaleY="6%" />

			<bitmap id="HeartSmallWhiteIcon" x="36%" y="91%"
				filename="../../resources/drawables/heart_64px_wht.png" scaleX="8%"
				scaleY="9%" />
			<bitmap id="ThermometerSmallWhiteIcon" x="36%" y="91%"
				filename="../../resources/drawables/thermometer_64px_wht.png" scaleX="8%"
				scaleY="8%" />
			<label id="currentHeartRateAndTemperatureValue" text="-" x="48%" y="94%"
				color="Graphics.COLOR_WHITE"
				font="Graphics.FONT_XTINY"
				justification="Graphics.TEXT_JUSTIFY_LEFT | Graphics.TEXT_JUSTIFY_VCENTER" />
		</layout>
	</layouts>
</resources>